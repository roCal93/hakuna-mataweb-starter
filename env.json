    { "name": "NEXT_PUBLIC_ALLOWED_ORIGINS", "required": false, "secret": false, "example": "http://localhost:3000", "description": "Public fallback CORS origins used by middleware when ALLOWED_ORIGINS is unset" },
    { "name": "NEXT_PUBLIC_DISABLE_DARK", "required": false, "secret": false, "example": "false", "description": "Disable dark mode globally when true" },
    { "name": "NEXT_PUBLIC_TWITTER_SITE", "required": false, "secret": false, "example": "", "description": "Twitter/X site handle for SEO cards" },
    { "name": "NEXT_PUBLIC_TWITTER_CREATOR", "required": false, "secret": false, "example": "", "description": "Twitter/X creator handle for SEO cards" },
    { "name": "STRAPI_API_TOKEN", "required": false, "secret": true, "example": "", "description": "Strapi read API token" },
    { "name": "STRAPI_PREVIEW_TOKEN", "required": false, "secret": true, "example": "", "description": "Strapi preview API token" },
    { "name": "STRAPI_WRITE_API_TOKEN", "required": false, "secret": true, "example": "", "description": "Strapi write API token" },
    { "name": "PREVIEW_SECRET", "required": false, "secret": true, "example": "changeme", "description": "Preview and draft secret" },
    { "name": "USE_DRAFT_MODE", "required": false, "secret": false, "example": "false", "description": "Enable draft mode" },
    { "name": "REVALIDATE_SECRET", "required": false, "secret": true, "example": "changeme", "description": "ISR revalidation secret" },
    { "name": "COMPANY_NAME", "required": false, "secret": false, "example": "Votre Entreprise", "description": "Company name used by emails" },
    { "name": "RESEND_API_KEY", "required": false, "secret": true, "example": "", "description": "Resend API key" },
    { "name": "RESEND_FROM_EMAIL", "required": false, "secret": false, "example": "contact@example.com", "description": "Default sender email" },
    { "name": "CONTACT_EMAIL", "required": false, "secret": false, "example": "contact@example.com", "description": "Contact recipient email" },
    { "name": "UPSTASH_REDIS_REST_URL", "required": false, "secret": false, "example": "", "description": "Upstash Redis URL for persistent rate limiting" },
    { "name": "UPSTASH_REDIS_REST_TOKEN", "required": false, "secret": true, "example": "", "description": "Upstash Redis token" },
    { "name": "PUBLIC_API_ALLOWED_ORIGINS", "required": false, "secret": false, "example": "", "description": "Allowed public API origins" },
    { "name": "ALLOWED_ORIGINS", "required": false, "secret": false, "example": "http://localhost:3000", "description": "Allowed CORS origins" }
  ],
  "strapi": [
    { "name": "HOST", "required": false, "secret": false, "example": "localhost", "description": "Strapi bind host" },
    { "name": "PORT", "required": false, "secret": false, "example": "1337", "description": "Strapi port" },
    { "name": "NODE_ENV", "required": false, "secret": false, "example": "development", "description": "Node environment" },
    { "name": "STRAPI_URL", "required": false, "secret": false, "example": "http://localhost:1337", "description": "Public URL of the Strapi server" },
    { "name": "APP_KEYS", "required": true, "secret": true, "example": "changeme1,changeme2", "description": "Strapi application keys" },
    { "name": "API_TOKEN_SALT", "required": true, "secret": true, "example": "changeme", "description": "Strapi API token salt" },
    { "name": "ADMIN_JWT_SECRET", "required": true, "secret": true, "example": "changeme", "description": "Strapi admin JWT secret" },
    { "name": "TRANSFER_TOKEN_SALT", "required": true, "secret": true, "example": "changeme", "description": "Strapi transfer token salt" },
    { "name": "ENCRYPTION_KEY", "required": true, "secret": true, "example": "changeme", "description": "Strapi encryption key" },
    { "name": "JWT_SECRET", "required": true, "secret": true, "example": "changeme", "description": "Strapi JWT secret" },
    { "name": "DATABASE_CLIENT", "required": false, "secret": false, "example": "sqlite", "description": "Database client" },
