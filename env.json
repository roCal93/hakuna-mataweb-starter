    { "name": "DATABASE_HOST", "required": false, "secret": false, "example": "localhost", "description": "Database host (Postgres)" },
    { "name": "DATABASE_PORT", "required": false, "secret": false, "example": "5432", "description": "Database port (Postgres)" },
    { "name": "DATABASE_NAME", "required": false, "secret": false, "example": "strapi", "description": "Database name (Postgres)" },
    { "name": "DATABASE_USERNAME", "required": false, "secret": false, "example": "strapi", "description": "Database user (Postgres)" },
    { "name": "DATABASE_PASSWORD", "required": false, "secret": true, "example": "changeme", "description": "Database password (Postgres)" },
    { "name": "DATABASE_SSL", "required": false, "secret": false, "example": "false", "description": "Enable database SSL" },
    { "name": "DATABASE_SSL_SELF", "required": false, "secret": false, "example": "false", "description": "Allow self-signed database SSL certificate" },
    { "name": "CLIENT_URL", "required": false, "secret": false, "example": "http://localhost:3000", "description": "Frontend URL allowed by Strapi" },
    { "name": "PREVIEW_SECRET", "required": false, "secret": true, "example": "changeme", "description": "Preview integration secret" },
    { "name": "ALLOWED_ORIGINS", "required": false, "secret": false, "example": "http://localhost:3000", "description": "Allowed CORS origins" },
    { "name": "CLOUDINARY_URL", "required": false, "secret": true, "example": "", "description": "Cloudinary connection URL" },
    { "name": "CLOUDINARY_NAME", "required": false, "secret": false, "example": "your_cloud", "description": "Cloudinary cloud name (alternative to CLOUDINARY_URL)" },
    { "name": "CLOUDINARY_KEY", "required": false, "secret": true, "example": "", "description": "Cloudinary API key (alternative to CLOUDINARY_URL)" },
    { "name": "CLOUDINARY_SECRET", "required": false, "secret": true, "example": "", "description": "Cloudinary API secret (alternative to CLOUDINARY_URL)" },
    { "name": "CLOUDINARY_FOLDER", "required": false, "secret": false, "example": "uploads", "description": "Cloudinary upload folder" }
  ]
}
